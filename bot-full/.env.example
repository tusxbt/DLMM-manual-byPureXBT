# Telegram (wajib)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789
# Whitelist user ID Telegram (wajib, pisahkan koma). Hanya ID ini yang bisa perintah bot.
ALLOWED_TELEGRAM_USER_IDS=123456789

# Solana — WALLET TERPISAH DANA KECIL SAJA (jangan wallet utama)
# Isi sendiri di file .env lokal. JANGAN kirim key lewat chat / commit ke git.
WALLET_PRIVATE_KEY=base58-secret-key-PLACEHOLDER
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional failover list (comma-separated). If set, used instead of RPC_URL alone; if empty, RPC_URL is used.
# On 429 / timeout / 5xx the bot switches to the next URL (cooldown ~45s). Logs show only rpc#N, never the URL/key.
# RPC_URLS=https://mainnet.helius-rpc.com/?api-key=KEY1,https://api.mainnet-beta.solana.com

# true = simulasi saja (default). Set false hanya setelah Anda paham risikonya.
DRY_RUN=true

# Slippage % (0.1–50). Meteora LIQ = percentage as-is; Jupiter SWAP = ×100 jadi bps.
SWAP_SLIPPAGE_PCT=10
LIQ_SLIPPAGE_PCT=10

# Opsional
HELIUS_API_KEY=
JUPITER_API_KEY=
DATA_DIR=./data
LOG_LEVEL=info

# Priority fee DLMM tx (micro-lamports/CU). 0 = auto dari recent fees
PRIORITY_FEE_MICROLAMPORTS=0
# Batas priority fee Jupiter per swap (lamports). 1000000 = 0.001 SOL
JUP_PRIORITY_MAX_LAMPORTS=1000000

# ── Multi-user ──
# Owner = OWNER_TELEGRAM_ID, or (if empty) the FIRST id in ALLOWED_TELEGRAM_USER_IDS.
# Owner trades with WALLET_PRIVATE_KEY above. Extra users are managed via /admin (stored in DATA_DIR/users.json).
OWNER_TELEGRAM_ID=
# 32-byte key that encrypts per-user wallets (AES-256-GCM). Generate: openssl rand -hex 32
# BACK THIS UP. Losing it = user wallets in DATA_DIR/wallets cannot be decrypted.
WALLET_ENCRYPTION_KEY=

# ── Pool scanner (read-only, /scan + npm run scan) — NO auto-trade / NO scheduler ──
# SCAN_MIN_TVL=10000
# SCAN_MAX_TVL=100000
# SCAN_MIN_VOL24H=25000
# SCAN_MAX_BIN_STEP=200
# SCAN_MIN_BIN_STEP=100
# SCAN_TOP_N=15
# SCAN_PAGES=3
# SCAN_NEW_POOL_HOURS=24
# SCAN_MIN_POOL_AGE_HOURS=6
# SCAN_MIN_HOLDERS=1000
# SCAN_MAX_TOP10_HOLDER_PCT=20
# SCAN_MIN_MARKET_CAP=500000
# SCAN_EXCLUDE_FREEZE_AUTH=true
# SCAN_EXCLUDE_MINT_AUTH=true
# SCAN_EXCLUDE_UNVERIFIED=false
# SCAN_BLACKLIST_MINTS=
# SCAN_INTERVAL_MINUTES=10
# Optional HTTP GET /scan/latest — OFF unless token set (Bearer auth)
# SCAN_HTTP_TOKEN=
# SCAN_HTTP_PORT=8787
# SCAN_HTTP_HOST=127.0.0.1

# ── Live Bins mini web (read-only) — OFF by default ──
# DEMO sim + unique /v/:token links from Telegram "📡 Live Bins".
# Never exposes wallet keys. No txs. Polls chain only while a session has viewers.
LIVE_WEB_ENABLED=false
# LIVE_WEB_HOST=127.0.0.1
# LIVE_WEB_PORT=8788
# Public URL shown in Telegram (tunnel/VPS later). Default = http://HOST:PORT
# LIVE_WEB_PUBLIC_URL=http://127.0.0.1:8788
